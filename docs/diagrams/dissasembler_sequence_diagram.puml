@startuml
title Sequence Diagram - Boot Script Disassembly Flow

autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor User
participant "DisassembleBootScriptUseCase" as UseCase
participant "FileLoader" as FileLoader
participant "KaitaiBootScriptRawParser" as RawParser
participant "BootScriptOpcodeDecoder" as ScriptDecoder
participant "OpcodeDecoderRegistry" as Registry
participant "Concrete OpcodeDecoder" as ConcreteDecoder

User -> UseCase : execute(path)

UseCase -> FileLoader : load(path)
FileLoader --> UseCase : BinarySource

UseCase -> RawParser : parse(source)
note right of RawParser
  Uses Python code
  generated from the .ksy
end note
RawParser --> UseCase : RawBootScript

UseCase -> ScriptDecoder : decode_header(raw_script.table_header)
ScriptDecoder --> UseCase : header_text

UseCase -> ScriptDecoder : decode_all(raw_script)

loop for each RawOpcodeRecord
  ScriptDecoder -> Registry : decode(record)
  Registry -> Registry : register(record.opcode_id)

  alt supported opcode
    Registry -> ConcreteDecoder : decode(record)
    ConcreteDecoder --> Registry : opcode_text
    Registry --> ScriptDecoder : opcode_text
  else unsupported / malformed opcode
    Registry -> ConcreteDecoder : decode(record)\n(UnknownOpcodeDecoder)
    ConcreteDecoder --> Registry : opcode_text
    Registry --> ScriptDecoder : opcode_text
  end
end

ScriptDecoder --> Renderer : opcode_lines

Renderer -> Renderer : render_lines(header_text, opcode_lines)

Renderer --> UseCase : IR

UseCase --> User : IR
@enduml