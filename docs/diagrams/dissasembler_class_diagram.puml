@startuml
title Class Diagram - Boot Script Disassembler

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

package "ingestion" {
  class BinarySource {
    +path: str
    +data: bytes
    +size(): int
  }

  class FileLoader {
    +load(path: str): BinarySource
  }
}

package "parsing.raw" {
  interface BootScriptRawParser {
    +parse(source: BinarySource): RawBootScript
  }

  class KaitaiBootScriptRawParser {
    +parse(source: BinarySource): RawBootScript
  }

  class RawBootScript {
    +table_header: RawTableHeader
    +records: list[RawOpcodeRecord]
  }

  class RawTableHeader {
    +magic: int
    +length: int
    +version: int
    +table_length: int
  }

  class RawOpcodeRecord {
    +opcode_id: int
    +length: int
    +offset: int
    +body: object
    +raw_bytes: bytes
    +payload_size(): int
  }
}

package "decoding" {
  interface OpcodeDecoder {
    +decode(record: RawOpcodeRecord): str
  }

  class OpcodeDecoderRegistry {
    +register(opcode_id: int, decoder: OpcodeDecoder): None
    +decode(record: RawOpcodeRecord): str
  }

  class WriteOpcodeDecoders <<group>> {
    IoWriteDecoder
    MemWriteDecoder
    PciConfigWriteDecoder
    PciConfig2WriteDecoder
  }

  class ReadWriteOpcodeDecoders <<group>> {
    IoReadWriteDecoder
    MemReadWriteDecoder
    PciConfigReadWriteDecoder
    PciConfig2ReadWriteDecoder
  }

  class PollOpcodeDecoders <<group>> {
    IoPollDecoder
    MemPollDecoder
    PciConfigPollDecoder
    PciConfig2PollDecoder
  }

  class OtherOpcodeDecoders <<group>> {
    SmbusExecuteDecoder
    StallDecoder
    DispatchDecoder
    Dispatch2Decoder
    InformationDecoder
    UnknownOpcodeDecoder
  }
}

package "application" {
  class DisassembleBootScriptUseCase {
    +execute(path: str): str
  }

  class BootScriptOpcodeDecoder {
    +decode_header(header: RawTableHeader): str
    +decode_all(raw_script: RawBootScript): list[str]
  }
}

package "reporting" {
  interface BootScriptRenderer {
    +render(raw_script: RawBootScript, opcode_decoder: BootScriptOpcodeDecoder): str
  }

  class TextIrRenderer {
    +render(raw_script: RawBootScript, opcode_decoder: BootScriptOpcodeDecoder): str
    +render_lines(header_text: str, opcode_lines: Sequence[str]): str
  }

  class JsonIrRenderer {
    +render(raw_script: RawBootScript, opcode_decoder: BootScriptOpcodeDecoder): str
  }
}

FileLoader --> BinarySource

BootScriptRawParser <|.. KaitaiBootScriptRawParser
KaitaiBootScriptRawParser --> RawBootScript
RawBootScript *-- "1" RawTableHeader
RawBootScript *-- "0..*" RawOpcodeRecord

OpcodeDecoderRegistry --> OpcodeDecoder
OpcodeDecoderRegistry --> RawOpcodeRecord

OpcodeDecoder ..> WriteOpcodeDecoders : implementations
OpcodeDecoder ..> ReadWriteOpcodeDecoders : implementations
OpcodeDecoder ..> PollOpcodeDecoders : implementations
OpcodeDecoder ..> OtherOpcodeDecoders : implementations

DisassembleBootScriptUseCase --> FileLoader
DisassembleBootScriptUseCase --> BootScriptRawParser
DisassembleBootScriptUseCase --> BootScriptOpcodeDecoder
DisassembleBootScriptUseCase --> BootScriptRenderer

BootScriptRenderer <|.. TextIrRenderer
BootScriptRenderer <|.. JsonIrRenderer

BootScriptOpcodeDecoder --> OpcodeDecoderRegistry : delegates per-record decoding
BootScriptOpcodeDecoder --> RawBootScript

note right of OpcodeDecoder
decode() transforms a raw opcode record
directly into its textual IR representation.
end note

note right of OpcodeDecoderRegistry
Resolves the concrete decoder for a given
opcode_id and delegates the raw decode.
end note

note right of BootScriptOpcodeDecoder
Coordinates boot script decoding.
Decodes the table header and iterates over
raw records, delegating each opcode record
to OpcodeDecoderRegistry.
end note

note right of WriteOpcodeDecoders
Grouped for readability.
Each listed decoder is registered independently
in OpcodeDecoderRegistry.
end note


note right of RawBootScript
Instead of has_errors(), use Exceptions
end note

@enduml