{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "s3boot_semantic",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "assignment_statement"
        },
        {
          "type": "SYMBOL",
          "name": "read_write_statement"
        },
        {
          "type": "SYMBOL",
          "name": "poll_statement"
        },
        {
          "type": "SYMBOL",
          "name": "call_statement"
        },
        {
          "type": "SYMBOL",
          "name": "call_context_statement"
        },
        {
          "type": "SYMBOL",
          "name": "stall_statement"
        },
        {
          "type": "SYMBOL",
          "name": "info_statement"
        },
        {
          "type": "SYMBOL",
          "name": "smbus_statement"
        }
      ]
    },
    "assignment_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "target"
          }
        },
        {
          "type": "STRING",
          "value": "<-"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        }
      ]
    },
    "read_write_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "target"
          }
        },
        {
          "type": "STRING",
          "value": "<-"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "source",
          "content": {
            "type": "SYMBOL",
            "name": "target"
          }
        },
        {
          "type": "STRING",
          "value": "&"
        },
        {
          "type": "FIELD",
          "name": "data_mask",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "FIELD",
          "name": "data",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        }
      ]
    },
    "poll_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "poll"
        },
        {
          "type": "STRING",
          "value": "until"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "target"
          }
        },
        {
          "type": "STRING",
          "value": "&"
        },
        {
          "type": "FIELD",
          "name": "data_mask",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": "=="
        },
        {
          "type": "FIELD",
          "name": "data",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        }
      ]
    },
    "call_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "call"
        },
        {
          "type": "FIELD",
          "name": "entry_point",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        }
      ]
    },
    "call_context_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "call"
        },
        {
          "type": "FIELD",
          "name": "entry_point",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "context",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "stall_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "stall"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "duration",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "info_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "info"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "information",
          "content": {
            "type": "SYMBOL",
            "name": "value"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "smbus_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "smbus_execute"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "argument_list"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "target": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "target_mem"
        },
        {
          "type": "SYMBOL",
          "name": "target_io"
        },
        {
          "type": "SYMBOL",
          "name": "target_pci"
        }
      ]
    },
    "argument_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "value"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "value"
              }
            ]
          }
        }
      ]
    },
    "target_mem": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "mem"
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "FIELD",
          "name": "address",
          "content": {
            "type": "SYMBOL",
            "name": "address"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "target_io": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "io"
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "FIELD",
          "name": "address",
          "content": {
            "type": "SYMBOL",
            "name": "address"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "target_pci": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "pci"
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "FIELD",
          "name": "address",
          "content": {
            "type": "SYMBOL",
            "name": "pci_location"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "pci_location": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "address"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "segment",
              "content": {
                "type": "SYMBOL",
                "name": "address"
              }
            },
            {
              "type": "STRING",
              "value": ":"
            },
            {
              "type": "FIELD",
              "name": "address",
              "content": {
                "type": "SYMBOL",
                "name": "address"
              }
            }
          ]
        }
      ]
    },
    "address": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "hex_number"
        },
        {
          "type": "SYMBOL",
          "name": "meta_variable"
        }
      ]
    },
    "value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "hex_number"
        },
        {
          "type": "SYMBOL",
          "name": "meta_variable"
        }
      ]
    },
    "hex_number": {
      "type": "PATTERN",
      "value": "0x[0-9a-fA-F]+"
    },
    "meta_variable": {
      "type": "PATTERN",
      "value": "[a-zA-Z_$][a-zA-Z0-9_]*"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}